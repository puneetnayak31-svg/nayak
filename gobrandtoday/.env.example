# ─────────────────────────────────────────────────────────────────────────────
# GoBrandToday — environment. Copy to `.env` (repo root). Never commit `.env`.
# Everything works with NO keys: offline name generator + free RDAP domain
# checks + compliant social checks. Add keys to unlock more.
# ─────────────────────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
APP_URL=http://localhost:3000              # public URL of the web app
API_ORIGIN=http://localhost:4000           # where the web app proxies /api/* (server-side only)
PORT=4000
DATABASE_URL=postgres://gbt:gbt@localhost:5432/gobrandtoday
DATABASE_SSL=false
SESSION_SECRET=change-me-to-32-random-characters   # REQUIRED in production
COOKIE_SECURE=false                        # true behind HTTPS (automatic when NODE_ENV=production)
LOG_LEVEL=info
NEXT_PUBLIC_SITE_URL=http://localhost:3000 # canonical URL for SEO metadata/sitemap

# Demo mode: forces mock domain + social data (always labelled "Demo" in the UI)
DEMO_MODE=false

# ── AI ───────────────────────────────────────────────────────────────────────
# auto = Anthropic if ANTHROPIC_API_KEY, else OpenAI if OPENAI_API_KEY, else offline
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
AI_MODEL=                                  # default: claude-opus-5-5 (Anthropic) / OPENAI_MODEL (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
AI_EFFORT=medium                           # brand bible: low | medium | high
AI_NAMES_EFFORT=low                        # naming rounds (faster)
AI_TIMEOUT_MS=120000

# ── Domains ─────────────────────────────────────────────────────────────────
# rdap (free, keyless, registry-authoritative) | godaddy | hostinger | namecheap | mock
DOMAIN_PROVIDER=rdap
DOMAIN_FALLBACK_PROVIDER=rdap              # used when the primary fails or can't answer
DOMAIN_TIMEOUT_MS=6000
GODADDY_API_KEY=
GODADDY_API_SECRET=
GODADDY_ENV=production                     # or "ote" (test environment)
HOSTINGER_API_TOKEN=                       # hPanel → Profile → API
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=                       # must be whitelisted in Namecheap
NAMECHEAP_SANDBOX=false
# Affiliate/referral query strings appended to "Buy" links, e.g. REFERRALCODE=ABC
AFFILIATE_HOSTINGER=
AFFILIATE_GODADDY=
AFFILIATE_NAMECHEAP=

# ── Social handles ──────────────────────────────────────────────────────────
SOCIAL_PROVIDER=live                       # live | mock
SOCIAL_TIMEOUT_MS=5000
SOCIAL_PROFILE_PROBES=true                 # single HEAD request to youtube.com/@handle when no API key
GITHUB_TOKEN=                              # optional: raises GitHub rate limit to 5,000/h
YOUTUBE_API_KEY=                           # optional: YouTube Data API v3 (official handle lookup)

# ── Auth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_API_URL=                            # defaults to APP_URL (redirect: $APP_URL/api/auth/google/callback)
ADMIN_EMAILS=                              # comma-separated; can read /api/admin/status

# ── Analytics, billing, limits ──────────────────────────────────────────────
ANALYTICS_PROVIDER=db                      # db | posthog | log | none
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
BILLING_PROVIDER=none                      # none | razorpay | stripe (adapters stubbed)
RATE_LIMIT_PER_MINUTE=120
AI_RATE_LIMIT_PER_MINUTE=20
FEATURE_ASSISTANT=true
FEATURE_DOMAIN_FIRST=true
FEATURE_GOOGLE_LOGIN=true
