# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Your domain, without https:// or www (www redirects to it). DNS A/AAAA records
# for the domain and www must point at this server before you start Caddy.
HIPL_DOMAIN=hipl.example

# First CMS password (used only the first time, before cms/state/config.json exists).
# Use 16+ random characters. Change it later in the CMS under Settings.
HIPL_CMS_PASSWORD=change-me-to-a-long-random-password

# Optional: the AI Composer key (can also be pasted in the CMS under Settings).
ANTHROPIC_API_KEY=

# Optional: only if the public site is hosted elsewhere (e.g. Vercel) and posts
# its forms to this server. Comma-separated origins.
HIPL_FORMS_ORIGINS=

# The host user that owns the checkout (run `id -u` and `id -g`).
HIPL_UID=1000
HIPL_GID=1000
