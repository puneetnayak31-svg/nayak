# Caddy reverse proxy for HIPL. Gets HTTPS certificates automatically.
# HIPL_DOMAIN is the bare domain (e.g. hipl.in); www.<domain> redirects to it.
# HIPL_UPSTREAM is where the CMS listens (cms:8800 in Docker, 127.0.0.1:8800 with systemd).

www.{$HIPL_DOMAIN} {
	redir https://{$HIPL_DOMAIN}{uri} permanent
}

{$HIPL_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# Static assets can be cached briefly by browsers.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=3600, must-revalidate"

	# Uploads from the public forms (Voices pitches with a file) can be ~7 MB as base64.
	request_body {
		max_size 25MB
	}

	reverse_proxy {$HIPL_UPSTREAM}
}
